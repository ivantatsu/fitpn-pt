# ------------------------------------------------------------------
# Configuración de FitPN. Copia este fichero a .env y edítalo.
# ¡No subas nunca el .env al repositorio!
# ------------------------------------------------------------------

# Entorno: production | development
APP_ENV=production

# Puerto público de la web (nginx)
WEB_PORT=8080

# PostgreSQL
POSTGRES_DB=fitpn
POSTGRES_USER=fitpn
POSTGRES_PASSWORD=cambia-esta-contraseña

# Secreto para firmar los JWT (mínimo 32 caracteres). Genera uno con:
#   openssl rand -base64 48
JWT_SECRET=

# Duración de los tokens
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Cookies solo por HTTPS (déjalo en true en producción)
COOKIE_SECURE=true

# Duración por defecto de un alta / renovación de socio (meses)
MEMBERSHIP_MONTHS=1

# Intentos de login por minuto (por IP y email)
LOGIN_RATE_PER_MINUTE=10

# Administrador inicial: se crea al arrancar SOLO si no existe ningún administrador.
# Tras el primer arranque puedes vaciar ADMIN_PASSWORD.
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
